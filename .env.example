# Croncave local configuration. Copy to .env (scripts/dev.sh does this for you).
# Every external provider is chosen here; the prototype uses mocks behind the real interfaces.

# --- Database ------------------------------------------------------------------------
# Leave empty and scripts/dev.sh starts a local Postgres in .dev/postgres (or Docker).
DATABASE_URL=

# --- Addresses -------------------------------------------------------------------------
API_ADDR=127.0.0.1:8080
# Previews live on their own domain so code people write never shares cookies with the app.
PREVIEW_ADDR=127.0.0.1:8081
PREVIEW_DOMAIN=preview.localhost:8081
# Where people open the web app (used in sign-in links).
WEB_URL=http://localhost:5173
# Where agents dial out to. Computers never listen; they connect here.
RELAY_URL=http://127.0.0.1:8080

# --- Providers (mock | real implementation names) ---------------------------------------
# Compute: local (a supervised process per computer), docker (a container per computer), fly (not configured yet)
COMPUTE_DRIVER=local
PAYMENTS=mock
NOTIFIER=outbox
AI=mock
MARKET_DATA=mock

# --- Compute: local and docker drivers ---------------------------------------------------
# Where computers' disks live.
DATA_DIR=.dev/data
AGENT_BIN=target/debug/croncave-agent
DOCKER_IMAGE=python:3.12-slim

# --- Compute: fly driver (not configured in the prototype) -------------------------------
FLY_API_TOKEN=
FLY_APP=

# --- Real providers, unused until their implementations exist ---------------------------
STRIPE_SECRET_KEY=
POSTMARK_TOKEN=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
MARKET_DATA_API_KEY=

# --- Secrets (generate your own; scripts/dev.sh fills these in .env) --------------------
# 32 bytes as hex. Encrypts job secrets at rest (stands in for a key management service).
SECRETS_KEY=
# Signs agent credentials.
RELAY_SECRET=

# --- Behaviour ------------------------------------------------------------------------
# People with these emails get the Admin pages.
ADMIN_EMAILS=admin@croncave.local
# Dev tools: the outbox page, the clock and demo controls. Never on in production.
DEV_TOOLS=true
# system | adjustable (adjustable lets Dev tools move time forward to end trials and months)
CLOCK=adjustable
# A computer stays awake instead of sleeping if its next job is due within this many seconds.
STAY_AWAKE_WITHIN_SECS=300
# Log filter for the services.
RUST_LOG=info,sqlx=warn,tower_http=warn
